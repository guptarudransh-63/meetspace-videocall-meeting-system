# MeetSpace Environment Configuration

# Application Port
PORT=5001
NODE_ENV=development

# Frontend Client URL (for CORS and cookie origin)
CLIENT_URL=http://localhost:5173

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/meetspace

# Authentication
JWT_SECRET=super-secret-meetspace-jwt-token-key-2025-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-meetspace-cookie-encryption-key-2025

# LiveKit SFU Configuration
# For local LiveKit server (or LiveKit Cloud wss://<your-project>.livekit.cloud)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Public URL accessible by the browser
VITE_LIVEKIT_URL=ws://localhost:7880

# Optional Email / SMTP (fallback to in-app invitations if omitted)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MeetSpace <no-reply@meetspace.dev>"
